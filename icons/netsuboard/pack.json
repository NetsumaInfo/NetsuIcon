{
  "version": 1,
  "name": "netsuboard",
  "mode": "micro",
  "size": 24,
  "style": {
    "fill": "none",
    "stroke": "currentColor",
    "strokeWidth": 2,
    "linecap": "round",
    "linejoin": "round"
  },
  "palette": {
    "ink": "currentColor",
    "accent": "#22d3ee"
  },
  "motion": {
    "ease": [
      0.2,
      0.8,
      0.2,
      1
    ],
    "hover": {
      "duration": [
        180,
        420
      ],
      "maxTranslate": 2,
      "maxRotate": 20,
      "scale": [
        0.9,
        1.1
      ]
    },
    "click": {
      "duration": [
        250,
        700
      ],
      "maxTranslate": 3,
      "maxRotate": 45,
      "scale": [
        0.85,
        1.15
      ]
    },
    "expressive": {
      "hover": {
        "duration": [
          250,
          700
        ],
        "maxTranslate": 4,
        "maxRotate": 45,
        "scale": [
          0.8,
          1.2
        ]
      },
      "click": {
        "duration": [
          400,
          1600
        ],
        "maxTranslate": 6,
        "maxRotate": 360,
        "scale": [
          0.75,
          1.25
        ]
      }
    },
    "feel": "precise, lively tools; instant actions one crisp gesture, long tasks a working loop with a clear done",
    "manner": "expressive"
  },
  "brief": "Action icons of NetsuBoard, a moodboard canvas for video editors: add, draw, arrange, render, upscale. Each icon says what its button does; long tasks move most."
}
