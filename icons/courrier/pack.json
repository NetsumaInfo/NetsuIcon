{
  "version": 1,
  "name": "courrier",
  "mode": "micro",
  "size": 24,
  "style": {
    "fill": "none",
    "stroke": "currentColor",
    "strokeWidth": 2,
    "linecap": "round",
    "linejoin": "round"
  },
  "palette": {
    "brand": "#7c5cff",
    "alert": "#ef4444"
  },
  "motion": {
    "feel": "Quick and precise. Starts fast, stops clean. Parts click into place like a well made machine; nothing floats.",
    "ease": [
      0.2,
      0,
      0,
      1
    ],
    "hover": {
      "duration": [
        300,
        650
      ],
      "maxTranslate": 3,
      "maxRotate": 30,
      "scale": [
        0.85,
        1.15
      ]
    },
    "click": {
      "duration": [
        400,
        900
      ],
      "maxTranslate": 12,
      "maxRotate": 90,
      "scale": [
        0.7,
        1.25
      ]
    },
    "expressive": {
      "hover": {
        "duration": [
          400,
          800
        ],
        "maxTranslate": 5,
        "maxRotate": 45,
        "scale": [
          0.8,
          1.25
        ]
      },
      "click": {
        "duration": [
          700,
          1600
        ],
        "maxTranslate": 36,
        "maxRotate": 360,
        "scale": [
          0.3,
          1.5
        ]
      }
    }
  },
  "brief": "The icons of a mail app for people who answer fast. Sharp, sure, a little mechanical. Lines in the colour of the text; violet for what the app does, red for what needs you."
}
