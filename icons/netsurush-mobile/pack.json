{
  "version": 1,
  "name": "netsurush-mobile",
  "mode": "micro",
  "size": 24,
  "style": {
    "fill": "none",
    "stroke": "currentColor",
    "strokeWidth": 2,
    "linecap": "round",
    "linejoin": "round"
  },
  "palette": {
    "ink": "currentColor"
  },
  "motion": {
    "ease": "ease-in-out",
    "hover": {
      "duration": [
        250,
        600
      ],
      "maxTranslate": 2,
      "maxRotate": 20,
      "scale": [
        0.9,
        1.1
      ]
    },
    "click": {
      "duration": [
        400,
        900
      ],
      "maxTranslate": 6,
      "maxRotate": 90,
      "scale": [
        0.7,
        1.25
      ]
    },
    "expressive": {
      "hover": {
        "duration": [
          400,
          900
        ],
        "maxTranslate": 4,
        "maxRotate": 45,
        "scale": [
          0.8,
          1.25
        ]
      },
      "click": {
        "duration": [
          800,
          1800
        ],
        "maxTranslate": 36,
        "maxRotate": 360,
        "scale": [
          0.4,
          1.5
        ]
      }
    },
    "feel": "No animation: still icons."
  },
  "brief": "Still interface icons of NetsuRush Mobile, an Android app to sort shots after a rush. Each icon shows plainly what its button does and reads at 20 to 24 dp."
}
